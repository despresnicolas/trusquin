meta {
  name: Supprimer un projet
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/api/projects?name=Mon projet
  body: none
  auth: none
}

params:query {
  name: Mon projet
}

headers {
  content-type: application/json
}

docs {
  Supprime toutes les versions d'un projet. Réponse : `{ deleted }`.
  400 si `name` manque.
}
