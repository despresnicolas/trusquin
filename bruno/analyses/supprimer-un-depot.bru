meta {
  name: Supprimer l'historique d'un dépôt
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/repos?path={{repoPath}}
  body: none
  auth: none
}

params:query {
  path: {{repoPath}}
}

headers {
  content-type: application/json
}

docs {
  Supprime toutes les analyses du dépôt. Réponse : { "deleted": <nombre> }.
  En-tête `content-type: application/json` requis : sans lui, SvelteKit renvoie 403 (contrôle CSRF des formulaires).
}
