{
  "name": "trusquin",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Application de bureau (Wails 3) qui génère la configuration Claude Code (CLAUDE.md, rules, skills, agents, hooks), avec contrôle qualité et analyse de repo.",
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync || echo \"\"",
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --minify false --mode development",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run && pnpm test:go",
    "test:i18n": "vitest run src/i18n-ui.test.ts src/lib/i18n.test.ts",
    "test:go": "mkdir -p dist && touch dist/.keep && go test ./...",
    "format": "prettier --write .",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@wailsio/runtime": "3.1.0",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
