{
  "name": "sauron",
  "version": "0.1.0",
  "private": true,
  "description": "Générateur de configuration Claude Code (CLAUDE.md, rules, skills, agents, hooks) avec contrôle qualité et analyse de repo.",
  "type": "module",
  "bin": {
    "sauron": "./cli/sauron.ts"
  },
  "scripts": {
    "prepare": "svelte-kit sync || echo \"\"",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "sauron": "tsx cli/sauron.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-node": "6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1",
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
